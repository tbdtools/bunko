{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bunko",
  "version": "0.1.0",
  "identifier": "com.bunko.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "bunko",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "cli": {
      "description": "A modern note-taking application",
      "args": [
        {
          "name": "path",
          "description": "Path to the notebook directory",
          "takesValue": true,
          "index": 1
        },
        {
          "name": "tui",
          "description": "Launch terminal UI instead of desktop app",
          "takesValue": false
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
